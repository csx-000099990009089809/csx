-- PAYLOAD BUILDER FUNCTION
function Config.BuildPayload(eventName, tool, bite)
    local data = Config.RemoteMap[eventName]
    if not data then return nil end

    local payload = {
        ["Action"]   = "Bite",
        ["FoodType"] = data.FoodType,
        ["Bite"]     = bite,
        ["Tool"]     = tool
    }

    if data.ExtraKey then
        payload[data.ExtraKey] = data.ExtraVal
    end

    return payload
end

